# Rotacion local rapida: tambien podes copiar keys.example.txt a keys.txt.
# Si existen .env y keys.txt, keys.txt gana para las API keys locales.

# Backend / servidor
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=
CORS_ORIGIN=*
PIPELINE_ACCESS_TOKEN=
OUTPUT_ROOT=outputs/jobs
MAX_SCRIPT_JSON_MB=2
MAX_SCENE_JSON_MB=20
MAX_ASSET_REQUEST_JSON_MB=4
MAX_UPLOAD_JSON_MB=80
MAX_RENDER_JSON_MB=300

# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium

# Pexels
PEXELS_API_KEY=

# Bright Data SERP API
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=serp_api1
BRIGHTDATA_COUNTRY=ar
BRIGHTDATA_LANGUAGE=es-419
BRIGHTDATA_FORMAT=raw
BRIGHTDATA_UNBLOCK_DATA_FORMAT=parsed_light

# Google Docs / Drive auth.
# Opcion A: service account JSON completo en una sola linea.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opcion B: ruta al JSON del service account.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Opcion C: access token temporal, util para pruebas.
GOOGLE_ACCESS_TOKEN=

# Opcional: Google Doc por defecto, equivalente al archivo observado por el trigger de n8n.
SOURCE_GDOC_ID=

# Carpeta padre de Drive donde se creara una carpeta por corrida.
# Para un Shared Drive, normalmente el ID del drive/root folder tambien funciona como parent.
DRIVE_ID=
DRIVE_PARENT_FOLDER_ID=
DRIVE_UPLOAD=true

# XML
# tmp-filename replica n8n: file://localhost//tmp/nombre.ext
# local-full-path usa la ruta real donde queda descargado el asset.
XML_PATH_MODE=tmp-filename

# Video
# Windows local: ejecutar powershell -ExecutionPolicy Bypass -File scripts/setup-windows-ffmpeg.ps1
# Si FFMPEG_PATH queda vacio, Windows busca automaticamente tools/ffmpeg/**/ffmpeg.exe o usa ffmpeg global.
FFMPEG_PATH=
VIDEO_SUBTITLE_FONT_NAME=Chakra Petch
VIDEO_SUBTITLE_FONT_SIZE=52
VIDEO_SUBTITLE_TEXT_COLOR=#ffffff
VIDEO_SUBTITLE_BACKGROUND_COLOR=#c21824

